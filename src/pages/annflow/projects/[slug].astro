---
import Base from '../../../layouts/Base.astro';
import WorldBar from '../../../components/WorldBar.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { asset } from '../../../data/asset';
import { getSeries, minutesOf, plural, type Series } from '../../../lib/annflow';

export async function getStaticPaths() {
  const all = await getSeries();
  return all.map((series, i) => ({
    params: { slug: series.slug },
    props: { series, next: all[i + 1] },
  }));
}

type Props = { series: Series; next?: Series };
const { series, next } = Astro.props;
const first = series.notes[0];
---
<Base title={`${series.title} — annFlow`} description={series.note}>
  <WorldBar crumbs={[{ label: 'annFlow', href: '/annflow/' }]} />
  <main class="container series">
    <header class="series__head">
      <h1>{series.title}</h1>
      <p class="series__note">{series.note}</p>
      <p class="series__meta">{series.notes.length} {plural(series.notes.length, 'заметка', 'заметки', 'заметок')} · {series.minutes} мин</p>
      <a class="series__start" href={asset(`/annflow/notes/${first.id}/`)}>Начать читать <span aria-hidden="true">→</span></a>
    </header>

    <h2 class="visually-hidden">Оглавление</h2>
    <ol class="toc">
      {series.notes.map((n, i) => (
        <li>
          <a href={asset(`/annflow/notes/${n.id}/`)}>
            <span class="toc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="toc__title">{n.data.title}</span>
            <span class="toc__time">{minutesOf(n)} мин</span>
          </a>
        </li>
      ))}
    </ol>

    {next && (
      <p class="series__next">
        <span>Следующая серия</span>
        <a href={asset(`/annflow/projects/${next.slug}/`)}>{next.title} <span aria-hidden="true">→</span></a>
      </p>
    )}
  </main>
  <SiteFooter />
</Base>

<style>
  .series {
    max-width: var(--index-width);
    padding-bottom: var(--space-5);
  }

  .series__head {
    padding-block: var(--space-4);
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 400;
    line-height: 1.1;
    text-wrap: balance;
  }

  .series__note {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    text-wrap: balance;
  }

  .series__meta {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .series__start {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    margin-top: var(--space-2);
    color: var(--color-accent);
    text-decoration: none;
  }

  .toc {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .toc a {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: var(--tap-row);
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background var(--duration) ease;
  }

  .toc a:hover,
  .toc a:active {
    background: var(--color-press);
  }

  .toc__num,
  .toc__time {
    flex: none;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .toc__title {
    flex: 1;
    min-width: 0;
    line-height: 1.35;
  }

  .series__next {
    display: flex;
    flex-direction: column;
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
  }

  .series__next a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    text-decoration: none;
  }
</style>
