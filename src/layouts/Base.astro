---
import { site } from '../data/site';
import { asset } from '../data/asset';
import { locales, localePath, toLocale, ui } from '../lib/i18n';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

type Props = { noindex?: boolean; title?: string; description?: string; ogTitle?: string; ogType?: string; alternate?: string };
const { noindex = false, title: pageTitle, description: pageDescription, ogTitle: pageOgTitle, ogType = 'website', alternate } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui[locale];
const title = pageTitle ?? (locale === 'en' ? site.en.title : site.title);
const description = pageDescription ?? (locale === 'en' ? site.en.description : site.description);
const ogDescription = pageDescription ?? (locale === 'en' ? site.en.ogDescription : site.ogDescription);
const ogTitle = pageOgTitle ?? pageTitle ?? site.ogTitle;
// Языковые версии есть у главной и у мира annFlow. alternate: путь страницы без языка.
const hasAlternates = !noindex && (!pageTitle || Boolean(alternate));
const canonical = new URL(Astro.url.pathname, site.url).href;
// hreflang: обе версии ссылаются друг на друга, x-default ведёт на русскую (advisory).
const alternates = locales.map((l) => ({ lang: l, href: new URL(localePath(l, alternate), site.url).href }));
const ogImage = new URL(site.ogImage, site.url).href;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
});
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {hasAlternates && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {hasAlternates && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <meta name="theme-color" content={site.themeColor} />
    <!-- ?v= сбрасывает кэш браузера: старый значок держится по прежнему адресу месяцами. Менять при смене иконки. -->
    <link rel="icon" href={asset('/favicon.ico?v=2')} sizes="48x48" />
    <link rel="icon" href={asset('/favicon.svg?v=2')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png?v=2')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.ogSiteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <slot />
  </body>
</html>
