---
import type { Project } from '../data/types';
type Props = { project: Project };
const { project } = Astro.props;
---
{project.longDescription?.length ? (
  <div class="project-details" id={`about-${project.id}`} data-about-panel>
    <div class="project-details__inner">
      {project.longDescription.map((p) => <p>{p}</p>)}
    </div>
  </div>
) : null}
{project.email && (
  <div class="project-contact">
    <a class="action action--row" href={`mailto:${project.email}`}>
      <span class="project-contact__row">Email<span class="project-contact__detail">{project.email}</span></span>
      <span class="action__arrow" aria-hidden="true">↗</span>
    </a>
  </div>
)}

<style>
  .project-details {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* Класс js ставит inline-скрипт в head: без JS About просто открыт. */
  :global(html.js) .project-details:not([data-open]) {
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
  }

  :global(html.about-ready) .project-details {
    transition:
      grid-template-rows var(--duration) ease,
      opacity var(--duration) ease,
      visibility var(--duration);
  }

  .project-details__inner {
    overflow: hidden;
    min-height: 0;
    max-width: 38rem;
    color: var(--color-muted);
  }

  .project-details__inner p {
    margin-top: var(--space-2);
  }

  .project-details__inner p:last-child {
    padding-bottom: var(--space-1);
  }

  /* Прямой контакт проекта: последняя строка под About, видна всегда.
     Как строка почты в «Контактах»: подпись, адрес приглушённо, стрелка справа. */
  .project-contact {
    display: flex;
    flex-direction: column;
  }

  .project-details[data-open] + .project-contact {
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .project-contact__row {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75em;
    min-width: 0;
  }

  .project-contact__detail {
    color: var(--color-muted);
    font-size: var(--text-meta);
    overflow-wrap: anywhere;
  }
</style>
