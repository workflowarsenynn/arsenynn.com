---
import type { Project } from '../data/types';
type Props = { project: Project };
const { project } = Astro.props;
---
{project.longDescription?.length ? (
  <div class="project-details" id={`about-${project.id}`} data-about-panel>
    <div class="project-details__inner">
      {project.longDescription.map((p) => <p>{p}</p>)}
      {project.email && (
        <p class="project-details__email">
          <a href={`mailto:${project.email}`}>{project.email}</a>
        </p>
      )}
    </div>
  </div>
) : null}

<style>
  .project-details {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* Класс js ставит inline-скрипт в head: без JS About просто открыт. */
  :global(html.js) .project-details:not([data-open]) {
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
  }

  :global(html.about-ready) .project-details {
    transition:
      grid-template-rows var(--duration) ease,
      opacity var(--duration) ease,
      visibility var(--duration);
  }

  .project-details__inner {
    overflow: hidden;
    min-height: 0;
    max-width: 38rem;
    color: var(--color-muted);
  }

  .project-details__inner p {
    margin-top: var(--space-2);
  }

  /* Почта проекта: сам адрес, без подписи. Белый на приглушённом тексте, высота пальца. */
  .project-details__email a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
    transition: text-decoration-color var(--duration) ease;
  }

  .project-details__email a:hover,
  .project-details__email a:focus-visible {
    text-decoration-color: var(--color-accent);
  }

  .project-details__inner p:last-child {
    padding-bottom: var(--space-1);
  }
</style>
