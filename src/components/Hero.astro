---
import { site } from '../data/site';
import { asset } from '../data/asset';
import { toLocale } from '../lib/i18n';
const { hero } = site;
const line = toLocale(Astro.currentLocale) === 'en' ? site.en.heroLine : hero.line;
---
<section class="hero container" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__title">
    {hero.logo ? (
      <img
        class="hero__logo"
        src={asset(hero.logo.src)}
        width={hero.logo.width}
        height={hero.logo.height}
        alt={hero.title}
        fetchpriority="high"
      />
    ) : (
      <>{hero.title}<span class="hero__dot" aria-hidden="true"></span></>
    )}
  </h1>
  {line && <p class="hero__line">{line}</p>}
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Компактно: первый проект виден на первом экране телефона. */
    min-height: 46vh;
    min-height: 46svh;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero__logo {
    display: block;
    width: min(100%, 21rem);
    height: auto;
  }

  @media (min-width: 48rem) {
    .hero__logo {
      width: 30rem;
    }
  }

  .hero__dot {
    display: inline-block;
    width: 0.14em;
    height: 0.14em;
    margin-left: 0.06em;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .hero__line {
    margin-top: var(--space-3);
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    color: var(--color-text);
  }

</style>
