---
import { site } from '../data/site';
import { asset } from '../data/asset';
import { toLocale } from '../lib/i18n';
const { hero } = site;
const line = toLocale(Astro.currentLocale) === 'en' ? site.en.heroLine : hero.line;
---
<section class="hero container" aria-labelledby="hero-title">
  {hero.portrait && (
    <img
      class="hero__portrait"
      src={asset(hero.portrait.src)}
      width={hero.portrait.width}
      height={hero.portrait.height}
      alt=""
      decoding="async"
    />
  )}
  <h1 id="hero-title" class="hero__title">
    {hero.logo ? (
      <img
        class="hero__logo"
        src={asset(hero.logo.src)}
        width={hero.logo.width}
        height={hero.logo.height}
        alt={hero.title}
        fetchpriority="high"
      />
    ) : (
      <>{hero.title}<span class="hero__dot" aria-hidden="true"></span></>
    )}
  </h1>
  {line && <p class="hero__line">{line}</p>}
</section>

<style>
  /* Центрированный титульный кадр: лицо по центру, wordmark и строка под ним, как титры. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-5);
  }

  .hero__portrait {
    display: block;
    width: min(42vw, 11rem);
    height: auto;
    margin-top: var(--space-2);
    /* wordmark стоит чуть ниже кадра, с воздухом, а не поверх подбородка */
    margin-bottom: var(--space-2);
    -webkit-mask-image: radial-gradient(ellipse 70% 72% at 58% 40%, #000 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 72% at 58% 40%, #000 45%, transparent 100%);
    pointer-events: none;
    user-select: none;
  }

  .hero__title,
  .hero__line {
    position: relative;
    z-index: 1;
  }

  .hero__title {
    line-height: 0.95;
  }

  .hero__logo {
    display: block;
    /* ширина wordmark ≈ 1.6 × ширины портрета (золотое сечение) */
    width: min(100%, 18rem);
    height: auto;
    margin-inline: auto;
  }

  .hero__line {
    margin-top: var(--space-3);
    max-width: 20rem;
    text-wrap: balance;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    color: var(--color-text);
  }

  @media (min-width: 48rem) {
    .hero__portrait {
      width: 15rem;
      margin-bottom: var(--space-3);
    }

    .hero__logo {
      width: 24rem;
    }

    .hero__line {
      max-width: 30rem;
    }
  }
</style>
