---
import { site } from '../data/site';
import { asset } from '../data/asset';
import { toLocale } from '../lib/i18n';
const { hero } = site;
const line = toLocale(Astro.currentLocale) === 'en' ? site.en.heroLine : hero.line;
---
<section class="hero container" aria-labelledby="hero-title">
  {hero.portrait && (
    <img
      class="hero__portrait"
      src={asset(hero.portrait.src)}
      width={hero.portrait.width}
      height={hero.portrait.height}
      alt=""
      decoding="async"
    />
  )}
  <h1 id="hero-title" class="hero__title">
    {hero.logo ? (
      <img
        class="hero__logo"
        src={asset(hero.logo.src)}
        width={hero.logo.width}
        height={hero.logo.height}
        alt={hero.title}
        fetchpriority="high"
      />
    ) : (
      <>{hero.title}<span class="hero__dot" aria-hidden="true"></span></>
    )}
  </h1>
  {line && <p class="hero__line">{line}</p>}
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Телефон: wordmark начинается ниже огонька в кадре (~70% высоты портрета). */
    padding-top: min(68vw, 22rem);
    padding-bottom: var(--space-4);
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero__logo {
    display: block;
    position: relative;
    width: min(100%, 21rem);
    height: auto;
  }

  @media (min-width: 48rem) {
    .hero__logo {
      width: 30rem;
    }
  }

  .hero__dot {
    display: inline-block;
    width: 0.14em;
    height: 0.14em;
    margin-left: 0.06em;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .hero__line {
    margin-top: var(--space-3);
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    color: var(--color-text);
  }


  /* Титульный кадр: лицо справа уходит в край экрана и под шапку,
     wordmark стоит поверх тёмной нижней части кадра, как титр. */
  .hero__portrait {
    position: absolute;
    z-index: 0;
    top: -3.5rem;
    right: 0; /* край padding-box = край экрана на телефоне */
    width: min(82vw, 26rem);
    height: auto;
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 72% 38%, #000 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 80% at 72% 38%, #000 45%, transparent 100%);
    pointer-events: none;
    user-select: none;
  }

  .hero__title,
  .hero__line {
    position: relative;
    z-index: 1;
  }

  /* Desktop: кадр на всю высоту первого экрана, от шапки до линии. */
  @media (min-width: 64rem) {
    .hero {
      min-height: 30rem;
      padding-top: var(--space-5);
    }

    .hero__portrait {
      top: -3.5rem;
      right: 0;
      width: auto;
      height: calc(100% + 3.5rem);
    }
  }
</style>
