---
import Base from '../layouts/Base.astro';
import WorldBar from './WorldBar.astro';
import SiteFooter from './SiteFooter.astro';
import { site } from '../data/site';
import { toLocale } from '../lib/i18n';
const p = site.privacy[toLocale(Astro.currentLocale)];
---
<Base title={`${p.title} — @arsenynn`} description={p.title} alternate="/privacy/">
  <WorldBar crumbs={[]} alternate="/privacy/" />
  <main class="container privacy">
    <h1>{p.title}</h1>
    {p.text.map((para) => <p>{para}</p>)}
    <button type="button" data-consent-reset data-done={p.done}>{p.reset}</button>
  </main>
  <SiteFooter />
</Base>

<style>
  .privacy {
    max-width: 44rem;
    padding-block: var(--space-4) var(--space-5);
  }

  h1 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 400;
  }

  button {
    min-height: var(--tap);
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-text);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }

  button:disabled {
    color: var(--color-muted);
    text-decoration: none;
    cursor: default;
  }
</style>
