---
// Личный контакт: тише проектов и блока Work, только типографика и тонкие линии.
import { site } from '../data/site';
import { toLocale, ui } from '../lib/i18n';
const t = ui[toLocale(Astro.currentLocale)];
---
<section class="contact container" id="contact" aria-labelledby="contact-title">
  <div class="contact__inner">
    <h2 class="contact__title" id="contact-title">{t.contactLabel}</h2>
    <div class="action-list">
      {site.contact.links.map((link) => (
        <a class="action action--row" href={link.url} {...(link.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
          <span class="contact__row">{link.label}<span class="contact__detail">{link.detail}</span></span>
          <span class="action__arrow" aria-hidden="true">↗</span>{link.url.startsWith('http') && <span class="visually-hidden">{t.newTab}</span>}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact {
    scroll-margin-top: var(--space-3);
  }

  .contact__inner {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .contact__title {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-meta);
  }

  .contact__row {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75em;
  }

  .contact__detail {
    color: var(--color-muted);
    font-size: var(--text-meta);
  }
</style>
