---
// Раскрытые проекты на главной: лента с прокруткой вбок, новые слева.
// Следующая карточка выглядывает из-за края, так видно, что лента идёт дальше.
import type { Project } from '../data/types';
import { toLocale, ui } from '../lib/i18n';
import { asset } from '../data/asset';

type Props = { project: Project };
const { project } = Astro.props;
const items = project.contents ?? [];
const t = ui[toLocale(Astro.currentLocale)];
const headingId = `strip-${project.id}`;
---
<section class="strip" aria-labelledby={headingId}>
  <div class="strip__head">
    <h3 class="strip__label" id={headingId}>{t.contentsLabel} <span class="strip__count">{items.length}</span></h3>
    <a class="strip__all" href={asset(project.contentsAll!)}>{t.allLabel}<span aria-hidden="true">→</span><span class="visually-hidden">: {project.title}</span></a>
  </div>
  <ul class="strip__track">
    {items.map((item) => (
      <li class="strip__item">
        <a class="strip__card" href={asset(item.path!)}>
          <span class="strip__frame" aria-hidden="true">
            {item.thumb && <img src={asset(item.thumb)} width="480" height="270" alt="" loading="lazy" decoding="async" />}
          </span>
          <span class="strip__title">{item.title}</span>
          {item.note && <span class="strip__note">{item.note}</span>}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .strip {
    margin-block: var(--space-2);
  }

  .strip__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap);
  }

  .strip__label {
    margin: 0;
    font: inherit;
  }

  .strip__count {
    margin-left: 0.25em;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .strip__all {
    justify-content: flex-end;
    gap: 0.3em;
    min-width: var(--tap);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-muted);
    font-size: var(--text-meta);
    text-decoration: none;
    transition: color var(--duration) ease;
  }

  .strip__all:hover {
    color: var(--color-text);
  }

  /* Лента доходит до края экрана: карточка обрезается краем, а не полем страницы. */
  .strip__track {
    display: flex;
    gap: var(--space-2);
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) var(--space-1);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    list-style: none;
  }

  .strip__item {
    flex: none;
    width: min(72%, 17rem);
    scroll-snap-align: start;
  }

  .strip__card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--color-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .strip__frame {
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: 0.4rem;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-press);
  }

  .strip__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duration) ease;
  }

  .strip__card:hover img {
    opacity: 0.8;
  }

  .strip__title {
    font-family: var(--font-display);
    line-height: 1.25;
  }

  .strip__note {
    color: var(--color-muted);
    font-size: var(--text-meta);
    line-height: 1.4;
  }

  /* Мышью вбок не потянуть, поэтому там лента показывает тонкую полосу прокрутки. */
  @media (hover: hover) and (pointer: fine) {
    .strip__track {
      padding-bottom: var(--space-2);
      scrollbar-width: thin;
      scrollbar-color: var(--color-line) transparent;
    }
  }

  @media (min-width: 48rem) {
    .strip__track {
      margin-inline: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
    }

    .strip__item {
      width: 15rem;
    }
  }
</style>
