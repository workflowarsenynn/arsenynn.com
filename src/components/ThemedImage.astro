---
// Картинка с отдельной версией для светлой темы (prefers-color-scheme: light).
import type { Asset } from '../data/types';
import { asset } from '../data/asset';

type Props = { image: Asset; alt: string; class?: string; loading?: 'lazy' | 'eager' };
const { image, alt, class: className, loading = 'lazy' } = Astro.props;
---
<picture>
  {image.srcLight && <source srcset={asset(image.srcLight)} media="(prefers-color-scheme: light)" />}
  <img
    class={className}
    src={asset(image.src)}
    width={image.width}
    height={image.height}
    alt={alt}
    loading={loading}
    decoding="async"
  />
</picture>
