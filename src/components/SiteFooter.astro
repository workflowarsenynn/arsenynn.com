---
import { site } from '../data/site';
import { asset } from '../data/asset';
import { localePath, toLocale } from '../lib/i18n';
// Год вычисляется при сборке.
const year = new Date().getFullYear();
const locale = toLocale(Astro.currentLocale);
---
<footer class="site-footer container meta">
  <p class="site-footer__inner">{site.footer.name} <span>{year}</span>{site.metrics.yandexId && <> · <a href={asset(localePath(locale, '/privacy/'))}>{site.privacy[locale].title}</a></>}</p>
</footer>

<style>
  .site-footer__inner {
    padding-top: var(--space-3);
    padding-bottom: max(var(--space-4), env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
  }
</style>
