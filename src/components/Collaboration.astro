---
import { site } from '../data/site';
import ActionLink from './ActionLink.astro';
import { toLocale, ui } from '../lib/i18n';
const { work } = site;
const text = toLocale(Astro.currentLocale) === 'en' ? site.en.workText : work.text;
---
<section class="work container" id="work" aria-labelledby="work-title">
  <div class="work__inner">
    <h2 class="work__title" id="work-title">{work.title}</h2>
    <p class="meta">{work.descriptor}</p>
    <p class="work__text">{text}</p>
    <div class="work__actions action-list">
      {work.links.map((link) =>
        'soon' in link && link.soon ? (
          <span class="action action--row work__soon" aria-disabled="true">
            {link.label}<span class="work__soon-label">{ui[toLocale(Astro.currentLocale)].soon}</span>
          </span>
        ) : (
          <ActionLink label={link.label} url={link.url} primary={'primary' in link && link.primary} />
        )
      )}
    </div>
  </div>
</section>

<style>
  .work__inner {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-text);
  }

  .work__title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    overflow-wrap: normal;
    margin-bottom: var(--space-1);
  }

  .work__text {
    margin-top: var(--space-2);
    max-width: 38rem;
  }

  .work__actions {
    margin-top: var(--space-3);
  }

  @media (min-width: 48rem) {
    .work__inner {
      max-width: var(--index-width);
      margin-inline: auto;
      padding-left: calc(8rem + var(--space-3));
      padding-block: var(--space-6);
    }
  }

  .work__soon {
    color: var(--color-muted);
    cursor: default;
  }

  .work__soon:hover {
    background: none;
  }

  .work__soon-label {
    font-size: var(--text-meta);
    letter-spacing: 0.04em;
  }
</style>
