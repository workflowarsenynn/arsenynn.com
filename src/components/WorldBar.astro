---
// Верхняя строка внутренних страниц: путь назад, не меню.
import { asset } from '../data/asset';
import { localePath, toLocale, ui } from '../lib/i18n';

type Crumb = { label: string; href: string };
type Props = { crumbs: Crumb[]; alternate: string };
const { crumbs, alternate } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const other = locale === 'ru' ? 'en' : 'ru';
const t = ui[locale];
---
<nav class="world-bar container" aria-label={t.annflow.path}>
  <a href={asset(localePath(locale))}>@arsenynn</a>
  {crumbs.map((c) => (
    <>
      <span aria-hidden="true">/</span>
      <a href={asset(localePath(locale, c.href))}>{c.label}</a>
    </>
  ))}
  <a class="world-bar__lang" href={asset(localePath(other, alternate))} hreflang={other} lang={other}>
    <span aria-hidden="true">{t.switchLabel}</span><span class="visually-hidden">{t.switchName}</span>
  </a>
</nav>

<style>
  .world-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-1);
    padding-top: max(var(--space-1), env(safe-area-inset-top));
    color: var(--color-muted);
    font-size: var(--text-meta);
  }

  .world-bar__lang {
    margin-left: auto;
    letter-spacing: 0.06em;
  }

  .world-bar a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration) ease;
  }

  .world-bar a:hover {
    color: var(--color-text);
  }
</style>
