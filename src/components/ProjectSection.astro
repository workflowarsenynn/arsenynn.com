---
import type { Project } from '../data/types';
import ProjectActions from './ProjectActions.astro';
import ProjectDetails from './ProjectDetails.astro';

type Props = { project: Project };
const { project } = Astro.props;
const number = String(project.order).padStart(2, '0');
const headingId = `project-${project.id}`;
// Разрешить перенос перед внутренним «@» (workflow@arsenynn), а не посреди слова.
const titleParts = project.title.split(/(?=@)/);
---
<article class="project" id={project.slug} aria-labelledby={headingId}>
  <p class="project__number" aria-hidden="true">{number}</p>
  <div class="project__body">
    <h2 class="project__title" id={headingId}>
      {project.logo ? (
        <img
          class="project__logo"
          src={project.logo.src}
          width={project.logo.width}
          height={project.logo.height}
          alt={project.title}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <>
          {project.mark && (
            <img
              class="project__mark"
              src={project.mark.src}
              width={project.mark.width}
              height={project.mark.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          {titleParts.map((part, i) => (i > 0 ? <><wbr />{part}</> : part))}
        </>
      )}
    </h2>
    <ul class="project__tags meta" aria-label="Темы">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="project__short">{project.shortDescription}</p>
    <ProjectActions project={project} />
    <ProjectDetails project={project} />
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 0.75rem;
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .project__number {
    padding-top: 0.55rem;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .project__title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    overflow-wrap: normal;
  }

  .project__logo {
    display: block;
    width: auto;
    height: var(--logo-height);
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  /* Знак стоит в строке над названием: длинные названия не теряют ширину. */
  .project__mark {
    display: block;
    width: auto;
    height: var(--mark-height);
    margin-bottom: var(--space-1);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .project__tags li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.45em;
    color: var(--color-accent);
    font-weight: 700;
  }

  .project__short {
    margin-top: var(--space-2);
    max-width: 38rem;
  }

  @media (min-width: 48rem) {
    .project {
      grid-template-columns: 8rem minmax(0, 1fr);
      column-gap: var(--space-3);
      padding-block: var(--space-5);
    }

    .project__number {
      padding-top: 0.9rem;
    }
  }
</style>
