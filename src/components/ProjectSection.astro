---
import type { ProjectView } from '../data/projects';
import { relative } from '../lib/activity';
import { toLocale, ui } from '../lib/i18n';
import { asset } from '../data/asset';
import ProjectActions from './ProjectActions.astro';
import ProjectDetails from './ProjectDetails.astro';

type Props = { project: ProjectView; position: number };
const { project, position } = Astro.props;
// Номер — место в индексе сейчас: свежие проекты поднимаются наверх.
const number = String(position).padStart(2, '0');
const locale = toLocale(Astro.currentLocale);
const t = ui[locale];
// Оптическое выравнивание знаков: одинаковая площадь при разных пропорциях.
const markK = project.mark
  ? ((project.mark.scale ?? 1) / Math.sqrt(project.mark.width / project.mark.height)).toFixed(3)
  : undefined;
const when = project.lastActivity ? relative(project.lastActivity, locale) : undefined;
const headingId = `project-${project.id}`;
// Разрешить перенос перед внутренним «@» (workflow@arsenynn), а не посреди слова.
const titleParts = project.title.split(/(?=@)/);
---
<article class="project" id={project.slug} aria-labelledby={headingId}>
  <div class="project__meta">
    <p class="project__number" title={when ? `${t.updated} ${when}` : undefined}>
      <span class:list={['signal', `signal--${project.signal}`]} aria-hidden="true"></span>
      <span class="project__index" aria-hidden="true">{number}</span>
      {when && <span class="visually-hidden">{t.updated} {when}</span>}
    </p>
    {project.mark && (
      <img
        class:list={['project__mark', { 'project__mark--photo': project.mark.photo }]}
        style={`--mark-k: ${markK}`}
        src={asset(project.mark.src)}
        width={project.mark.width}
        height={project.mark.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <div class="project__body">
    <div class:list={['project__head', { 'project__head--sticker': project.sticker }]}>
      <h2 class:list={['project__title', { 'project__title--accent': project.accent }]} id={headingId}>
        {project.logo ? (
          <img
            class="project__logo"
            src={asset(project.logo.src)}
            width={project.logo.width}
            height={project.logo.height}
            alt={project.title}
            loading="lazy"
            decoding="async"
          />
        ) : (
          titleParts.map((part, i) => (i > 0 ? <><wbr />{part}</> : part))
        )}
      </h2>
      {project.sticker && (
        <img
          class:list={['project__sticker', `project__sticker--${project.sticker.placement}`]}
          src={asset(project.sticker.src)}
          width={project.sticker.width}
          height={project.sticker.height}
          alt={project.sticker.alt}
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
    <ul class="project__tags meta" aria-label={t.tagsLabel}>
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="project__short">{project.shortDescription}</p>
  </div>

  <div class="project__actions">
    <ProjectActions project={project} />
  </div>

  <div class="project__details">
    <ProjectDetails project={project} />
  </div>
</article>

<style>
  /* Телефон: одна колонка. Строка «номер ... знак» работает как шапка записи. */
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'meta' 'body' 'actions' 'details';
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .project__meta {
    grid-area: meta;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--mark-size);
    margin-bottom: var(--space-3);
  }

  .project__number {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  /* Сигнальный огонёк, как лампочка записи: залитый — обновлялся на неделе,
     кольцо — за полтора месяца, пусто — тишина. Без анимации. */
  .signal {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .signal--live {
    background: var(--color-accent);
  }

  .signal--recent {
    box-shadow: inset 0 0 0 1.5px var(--color-accent);
  }

  .project__mark--photo {
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--color-line-strong);
  }

  .project__mark {
    display: block;
    width: auto;
    height: calc(var(--mark-size) * var(--mark-k, 1));
  }

  .project__body {
    grid-area: body;
  }

  .project__actions {
    grid-area: actions;
  }

  .project__details {
    grid-area: details;
  }

  .project__title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    overflow-wrap: normal;
  }

  .project__logo {
    display: block;
    width: auto;
    height: var(--logo-height);
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .project__title--accent {
    color: var(--color-accent);
  }

  /* Наклейка привязана к ширине названия, а не к viewport.
     Телефон: приклеена поверх правого верхнего края, низ слегка задевает последние буквы. */
  .project__head--sticker {
    position: relative;
    width: fit-content;
    max-width: 100%;
    font-size: var(--text-title);
  }

  .project__sticker {
    position: absolute;
    z-index: 1;
    right: -0.4em;
    bottom: calc(100% - 0.4em);
    width: 2.2em;
    height: auto;
    max-width: none;
    pointer-events: none;
    user-select: none;
  }

  /* Рядом: маленький курсор >_ сразу после логотипа, на уровне нижней части букв.
     Размер в rem, потому что высота логотипа задана в rem, а не от шрифта. */
  .project__sticker.project__sticker--beside {
    top: auto;
    right: auto;
    bottom: 0.95rem;
    left: calc(100% + 0.6rem);
    width: 2.1rem;
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .project__tags li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.45em;
    color: var(--color-accent);
    font-weight: 700;
  }

  .project__short {
    margin-top: var(--space-2);
    max-width: 34rem;
  }

  /* Планшет и desktop: номер и знак слева, всё остальное одной колонкой под текстом.
     Индекс центрирован, как hero; ссылки и раскрытые списки на всю ширину текста. */
  @media (min-width: 48rem) {
    .project {
      grid-template-columns: 8rem minmax(0, 1fr);
      grid-template-areas:
        'meta body'
        'meta actions'
        'meta details';
      column-gap: var(--space-3);
      max-width: var(--index-width);
      margin-inline: auto;
      padding-block: var(--space-6);
    }

    .project__meta {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-2);
      margin: 0;
      padding-top: 0.9rem;
    }

    /* Desktop: отдельный объект в свободном поле справа от названия, чуть выше строки. */
    .project__sticker {
      right: auto;
      bottom: auto;
      left: calc(100% + 0.9em);
      top: -0.3em;
      width: 2.4em;
    }
  }
</style>
