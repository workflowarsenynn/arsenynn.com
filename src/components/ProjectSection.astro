---
import type { Project } from '../data/types';
import { asset } from '../data/asset';
import ProjectActions from './ProjectActions.astro';
import ProjectDetails from './ProjectDetails.astro';

type Props = { project: Project };
const { project } = Astro.props;
const number = String(project.order).padStart(2, '0');
const headingId = `project-${project.id}`;
// Разрешить перенос перед внутренним «@» (workflow@arsenynn), а не посреди слова.
const titleParts = project.title.split(/(?=@)/);
---
<article class="project" id={project.slug} aria-labelledby={headingId}>
  <div class="project__meta">
    <p class="project__number" aria-hidden="true">{number}</p>
    {project.mark && (
      <img
        class="project__mark"
        src={asset(project.mark.src)}
        width={project.mark.width}
        height={project.mark.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <div class="project__body">
    <h2 class="project__title" id={headingId}>
      {project.logo ? (
        <img
          class="project__logo"
          src={asset(project.logo.src)}
          width={project.logo.width}
          height={project.logo.height}
          alt={project.title}
          loading="lazy"
          decoding="async"
        />
      ) : (
        titleParts.map((part, i) => (i > 0 ? <><wbr />{part}</> : part))
      )}
    </h2>
    <ul class="project__tags meta" aria-label="Темы">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="project__short">{project.shortDescription}</p>
  </div>

  <div class="project__actions">
    <ProjectActions project={project} />
  </div>

  <div class="project__details">
    <ProjectDetails project={project} />
  </div>
</article>

<style>
  /* Телефон: одна колонка. Строка «номер ... знак» работает как шапка записи. */
  .project {
    display: grid;
    grid-template-areas: 'meta' 'body' 'actions' 'details';
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .project__meta {
    grid-area: meta;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--mark-height);
    margin-bottom: var(--space-3);
  }

  .project__number {
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .project__mark {
    display: block;
    width: auto;
    height: var(--mark-height);
  }

  .project__body {
    grid-area: body;
  }

  .project__actions {
    grid-area: actions;
  }

  .project__details {
    grid-area: details;
  }

  .project__title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    overflow-wrap: normal;
  }

  .project__logo {
    display: block;
    width: auto;
    height: var(--logo-height);
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .project__tags li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.45em;
    color: var(--color-accent);
    font-weight: 700;
  }

  .project__short {
    margin-top: var(--space-2);
    max-width: 34rem;
  }

  /* Планшет: колонка номера и знака слева. */
  @media (min-width: 48rem) {
    .project {
      grid-template-columns: 8rem minmax(0, 1fr);
      grid-template-areas:
        'meta body'
        'meta actions'
        'meta details';
      column-gap: var(--space-3);
      padding-block: var(--space-6);
    }

    .project__meta {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-2);
      margin: 0;
      padding-top: 0.9rem;
    }
  }

  /* Desktop: номер | название и текст | действия (advisory, The Moving Index). */
  @media (min-width: 64rem) {
    .project {
      grid-template-columns: 8rem minmax(0, 1fr) 14rem;
      grid-template-areas:
        'meta body actions'
        'meta details .';
    }

    .project__actions {
      padding-top: 0.6rem;
    }
  }
</style>
