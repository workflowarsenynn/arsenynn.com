---
import { toLocale, ui } from '../lib/i18n';
type Props = { label: string; url: string; primary?: boolean; variant?: 'row' | 'text' };
const { label, url, primary = false, variant = 'row' } = Astro.props;
const t = ui[toLocale(Astro.currentLocale)];
---
<a
  class:list={['action', `action--${variant}`, { 'action--primary': primary }]}
  href={url}
  target="_blank"
  rel="noopener"
>
  {label}<span class="action__arrow" aria-hidden="true">↗</span><span class="visually-hidden">{t.newTab}</span>
</a>
