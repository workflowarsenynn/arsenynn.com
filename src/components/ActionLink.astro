---
import { localePath, toLocale, ui } from '../lib/i18n';
import { asset } from '../data/asset';
type Props = { label: string; url: string; primary?: boolean; variant?: 'row' | 'text'; live?: boolean; rel?: string; badge?: string };
const { label, url, primary = false, variant = 'row', live = false, rel = 'noopener', badge } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui[locale];
const internal = url.startsWith('/');
---
<a
  class:list={['action', `action--${variant}`, { 'action--primary': primary }]}
  href={internal ? asset(localePath(locale, url)) : url}
  target={internal ? undefined : '_blank'}
  rel={internal ? undefined : rel}
>
  <span class="action__label">
    {badge ? (
      <span class="action__offer">
        <span>{label}</span>
        <span class="action__badge">{badge}</span>
      </span>
    ) : label}
    {live && <span class="action__live" aria-hidden="true"></span>}
  </span><span class="action__arrow" aria-hidden="true">{internal ? '→' : '↗'}</span>{!internal && <span class="visually-hidden">{t.newTab}</span>}
</a>

<style>
  .action__offer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    padding-block: 0.45rem;
  }

  .action__badge {
    color: var(--color-muted);
    font-size: var(--text-meta);
    white-space: nowrap;
  }
</style>
