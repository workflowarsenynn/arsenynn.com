---
import type { Project } from '../data/types';
import ActionLink from './ActionLink.astro';
import { toLocale, ui } from '../lib/i18n';
import { asset } from '../data/asset';

type Props = { project: Project };
const { project } = Astro.props;
const hasAbout = Boolean(project.longDescription?.length);
const detailsId = `about-${project.id}`;
const contentsId = `contents-${project.id}`;
const locale = toLocale(Astro.currentLocale);
const t = ui[locale];
---
<div class="project-actions action-list">
  {project.links.map((link) => (
    <ActionLink label={link.label} url={link.url} primary={link.primary} />
  ))}
  {project.links.length === 0 && project.statusLabel && (
    <span class="action action--row project-actions__status">{project.statusLabel}</span>
  )}
  {project.parts?.map((part, i) => (
    <>
      <button
        class="action action--row project-actions__toggle"
        type="button"
        aria-expanded="true"
        aria-controls={`part-${project.id}-${i + 1}`}
        data-about-toggle
      >
        {part.label}<span class="project-actions__sign" aria-hidden="true" data-sign>−</span>
        <span class="visually-hidden">: {project.title}</span>
      </button>
      <div class="disclosure" id={`part-${project.id}-${i + 1}`}>
        <ul class="disclosure__inner contents" data-part={part.label}>
          {part.introText?.length && locale === 'ru' ? (
            <li>
              <button
                class="contents__link intro-toggle"
                type="button"
                aria-expanded="true"
                aria-controls={`intro-${project.id}-${i + 1}`}
                data-about-toggle
              >
                <span class="contents__title">{t.introLabel}</span>
                <span class="project-actions__sign" aria-hidden="true" data-sign>−</span>
                <span class="visually-hidden">: {part.label}</span>
              </button>
              <div class="disclosure" id={`intro-${project.id}-${i + 1}`}>
                <div class="disclosure__inner">
                  <div class="reading">
                    {part.introText.map((para) => <p>{para}</p>)}
                    {part.intro && (
                      <a class="action action--text reading__source" href={part.intro} target="_blank" rel="noopener">
                        {t.readInTelegram}<span class="action__arrow" aria-hidden="true">↗</span><span class="visually-hidden">{t.newTab}</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          ) : part.intro && (
            <li>
              <a class="contents__link" href={part.intro} target="_blank" rel="noopener">
                <span class="contents__title contents__title--muted">{t.introLabel}</span>
                <span class="action__arrow" aria-hidden="true">↗</span>
                <span class="visually-hidden">{t.newTab}</span>
              </a>
            </li>
          )}
          {part.chapters.map((ch) => (
            <li>
              <a class:list={['contents__link', 'chapter', { 'chapter--accent': ch.accent }]} href={ch.url} target="_blank" rel="noopener" data-video={ch.youtube} aria-haspopup={ch.youtube ? 'dialog' : undefined}>
                <span class="chapter__frame" aria-hidden="true">
                  {ch.thumb ? (
                    <img src={asset(ch.thumb)} width="288" height="162" alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="chapter__frame-num">{ch.num}</span>
                  )}
                </span>
                <span class="chapter__text">
                  <span class="chapter__meta" aria-hidden="true">
                    <span class="chapter__num">{ch.num}</span>
                    {ch.duration && <span class="chapter__time">{ch.duration}</span>}
                  </span>
                  <span class="chapter__title">{ch.title}</span>
                </span>
                {ch.youtube ? (
                  <>
                    <svg class="chapter__play only-js" viewBox="0 0 10 12" width="10" height="12" aria-hidden="true"><path d="M0 0l10 6-10 6z" /></svg>
                    <span class="action__arrow only-nojs" aria-hidden="true">↗</span>
                    <span class="visually-hidden only-js">{`${ch.num}${t.playVideo}`}</span>
                    <span class="visually-hidden only-nojs">{`${ch.num}${t.newTab}`}</span>
                  </>
                ) : (
                  <>
                    <span class="action__arrow" aria-hidden="true">↗</span>
                    <span class="visually-hidden">{`${ch.num}${t.newTab}`}</span>
                  </>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </>
  ))}
  {project.contents?.length && (
    <>
      <button
        class="action action--row project-actions__toggle"
        type="button"
        aria-expanded="true"
        aria-controls={contentsId}
        data-about-toggle
      >
        {t.contentsLabel}<span class="project-actions__sign" aria-hidden="true" data-sign>−</span>
        <span class="visually-hidden">: {project.title}</span>
      </button>
      <div class="disclosure" id={contentsId}>
        <ul class="disclosure__inner contents" data-part={project.title}>
          {project.contents.map((item) => (
            <li>
              <a class:list={['contents__link', { chapter: item.thumb, 'chapter--accent': item.accent }]} href={item.url} target="_blank" rel="noopener" data-video={item.youtube} aria-haspopup={item.youtube ? 'dialog' : undefined}>
                {item.thumb && (
                  <span class="chapter__frame" aria-hidden="true">
                    <img src={asset(item.thumb)} width="288" height="162" alt="" loading="lazy" decoding="async" />
                  </span>
                )}
                <span class="contents__text">
                  {item.meta && (
                    <span class="chapter__meta" aria-hidden="true">
                      <span class="chapter__num">{item.meta}</span>
                      {item.duration && <span class="chapter__time">{item.duration}</span>}
                    </span>
                  )}
                  <span class="contents__title">{item.title}</span>
                  {item.note && <span class="contents__note">{item.note}</span>}
                </span>
                {item.youtube ? (
                  <>
                    <svg class="chapter__play only-js" viewBox="0 0 10 12" width="10" height="12" aria-hidden="true"><path d="M0 0l10 6-10 6z" /></svg>
                    <span class="action__arrow only-nojs" aria-hidden="true">↗</span>
                    <span class="visually-hidden only-js">{t.playVideo}</span>
                    <span class="visually-hidden only-nojs">{t.newTab}</span>
                  </>
                ) : (
                  <>
                    <span class="action__arrow" aria-hidden="true">↗</span>
                    <span class="visually-hidden">{t.newTab}</span>
                  </>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </>
  )}
  {hasAbout && (
    <button
      class="action action--row project-actions__about"
      type="button"
      aria-expanded="true"
      aria-controls={detailsId}
      data-about-toggle
    >
      About<span class="project-actions__sign" aria-hidden="true" data-sign>−</span>
      <span class="visually-hidden">: {project.title}</span>
    </button>
  )}
</div>

<style>
  .project-actions {
    margin-top: var(--space-3);
  }


  .project-actions__about,
  .project-actions__status {
    color: var(--color-muted);
  }

  .project-actions__status {
    cursor: default;
  }

  .project-actions__status:hover {
    background: none;
  }

  /* Части и проекты — основной контент, поэтому белым; About остаётся серым. */
  .project-actions__toggle {
    color: var(--color-text);
  }

  .project-actions__about:hover {
    color: var(--color-text);
  }

  .project-actions__sign {
    display: inline-block;
    width: 1em;
    text-align: center;
    font-size: 1.1em;
  }

  .contents {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Строка оглавления: название и подзаголовок слева, стрелка справа, вся строка — ссылка. */
  .contents__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap-row);
    padding-block: 0.75rem;
    padding-left: var(--space-2);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .contents__link:hover,
  .contents__link:active {
    background: var(--color-press);
  }

  .contents__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contents__title--muted {
    color: var(--color-muted);
  }

  /* Строка главы: кадр 16:9 | номер · длительность над названием | ↗. Нажимается вся строка. */
  .chapter {
    justify-content: flex-start;
    gap: var(--space-2);
    padding-block: 0.6rem;
  }

  .chapter__frame {
    flex: none;
    display: grid;
    place-items: center;
    width: 5.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-press);
  }

  .chapter__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chapter__play {
    flex: none;
    margin-right: 0.15rem;
    fill: currentColor;
    transition: color var(--duration) ease;
  }

  .chapter:hover .chapter__play {
    color: var(--color-accent);
  }

  .chapter__frame-num {
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .chapter__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  /* Номер слева, время справа: не сливаются, время выстраивается в колонку. */
  .chapter__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  /* Хиты: красное название и значок. */
  .chapter--accent .chapter__title,
  .chapter--accent .contents__title,
  .chapter--accent .chapter__play {
    color: var(--color-accent);
  }

  .chapter__title,
  .chapter .contents__title {
    line-height: 1.3;
  }

  .contents__note {
    color: var(--color-muted);
    font-size: var(--text-meta);
    line-height: 1.4;
  }

  /* Кнопка «Вступление» в той же системе строк. */
  .intro-toggle {
    width: 100%;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* Текст вступления: advisory, long reading — Source Serif 4, мера ~62ch, 18/19 px, 1.6. */
  .reading {
    max-width: 62ch;
    padding: var(--space-4) var(--space-2) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-body);
    line-height: 1.62;
    color: var(--color-text);
    font-feature-settings: 'kern', 'liga';
    hanging-punctuation: first;
    text-wrap: pretty;
  }

  .reading p + p {
    margin-top: 1em;
  }

  .reading p:first-child::first-letter {
    color: var(--color-accent);
  }

  .reading__source {
    margin-top: var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
</style>
