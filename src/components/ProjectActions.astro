---
import type { Project } from '../data/types';
import ActionLink from './ActionLink.astro';
import ProjectStrip from './ProjectStrip.astro';
import PostStream from './PostStream.astro';
import { toLocale, ui } from '../lib/i18n';
import { streamPosts } from '../lib/stream';

type Props = { project: Project };
const { project } = Astro.props;
const hasAbout = Boolean(project.longDescription?.length);
const detailsId = `about-${project.id}`;
const locale = toLocale(Astro.currentLocale);
const t = ui[locale];
// Главы и работы идут в блоке по порядку, карточки в лентах включают их там же.
const film = Boolean(project.parts || project.contents);
const staged = new Set(film && project.stream ? streamPosts(project.stream).map((p) => p.post) : []);
const postOf = (url: string) => Number(url.split('/').pop());
const chapterOf = (url: string) => (staged.has(postOf(url)) ? postOf(url) : undefined);
---
<div class="project-actions action-list">
  {project.links.map((link) => (
    <ActionLink label={link.label} url={link.url} primary={link.primary} />
  ))}
  {project.links.length === 0 && project.statusLabel && (
    <span class="action action--row project-actions__status">{project.statusLabel}</span>
  )}
  {project.stream && (
    <PostStream source={project.stream} channel={project.links[0].url} film={film} label={film ? t.streamFilm : undefined} />
  )}
  {project.parts?.map((part, i) => (
    <ProjectStrip
      id={`part-${project.id}-${i + 1}`}
      label={part.label}
      owner={project.title}
      part={part.label}
      items={part.chapters.map((ch) => ({ ...ch, chapter: chapterOf(ch.url) }))}
      introId={`intro-${project.id}-${i + 1}`}
      introText={locale === 'ru' ? part.introText : undefined}
      introUrl={part.intro}
    />
  ))}
  {project.contents?.length && (
    <ProjectStrip
      id={`contents-${project.id}`}
      label={t.contentsLabel}
      owner={project.title}
      part={project.title}
      items={project.contents.map((item) => ({ ...item, num: item.meta, chapter: chapterOf(item.url) }))}
      all={project.contentsAll}
    />
  )}
  {hasAbout && (
    <button
      class="action action--row project-actions__about"
      type="button"
      aria-expanded="true"
      aria-controls={detailsId}
      data-about-toggle
    >
      About<span class="project-actions__sign" aria-hidden="true" data-sign>−</span>
      <span class="visually-hidden">: {project.title}</span>
    </button>
  )}
</div>

<style>
  .project-actions {
    margin-top: var(--space-3);
  }

  .project-actions__about,
  .project-actions__status {
    color: var(--color-muted);
  }

  .project-actions__status {
    cursor: default;
  }

  .project-actions__status:hover {
    background: none;
  }

  .project-actions__about:hover {
    color: var(--color-text);
  }

  .project-actions__sign {
    display: inline-block;
    width: 1em;
    text-align: center;
    font-size: 1.1em;
  }
</style>
