---
// Тело заметки: медиа, текст, файлы. Общее для страницы заметки и страницы серии.
import { render } from 'astro:content';
import NoteMedia from './NoteMedia.astro';
import { asset } from '../data/asset';
import type { Note } from '../lib/annflow';

type Props = { note: Note };
const { note } = Astro.props;
const { Content } = await render(note);
const { title, source, media = [], files = [] } = note.data;
const lead = media.filter((m) => m.post === source[0]);
const after = media.filter((m) => m.post !== source[0]);
---
{lead.length > 0 && <NoteMedia items={lead} title={title} />}
{note.body?.trim() && <div class="prose"><Content /></div>}
{after.length > 0 && <NoteMedia items={after} title={title} />}

{files.length > 0 && (
  <ul class="note__files">
    {files.map((f) => (
      <li><a class="action action--text" href={asset(`/files/annflow/${f}`)} download>{f}<span class="action__arrow" aria-hidden="true">↓</span></a></li>
    ))}
  </ul>
)}

<style>
  .note__files {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-meta);
  }
</style>
