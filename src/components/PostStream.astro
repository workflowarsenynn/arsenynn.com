---
// Случайные посты канала: сменяют друг друга в случайном порядке, всё играет здесь.
// Без JS остаётся один пост со ссылкой на Telegram.
import { toLocale, ui } from '../lib/i18n';
import { asset } from '../data/asset';
import posts from '../content/stream/bessmislennost.json';

type Props = { source: string; channel: string };
const { source, channel } = Astro.props;
const t = ui[toLocale(Astro.currentLocale)];
const first = posts.find((p) => p.kind === 'image')!;
---
<section
  class="stream"
  aria-label={t.streamLabel}
  data-stream={asset(source)}
  data-base={asset('/')}
  data-channel={channel}
  data-pause={t.streamPause}
  data-play={t.streamPlay}
  data-sound-on={t.streamSoundOn}
  data-sound-off={t.streamSoundOff}
>
  <div class="stream__head">
    <h3 class="stream__label">{t.streamLabel} <span class="stream__count" data-stream-count>{posts.length}</span></h3>
    <a class="stream__source" data-stream-link href={`${channel}/${first.post}`} target="_blank" rel="noopener">
      Telegram<span aria-hidden="true">↗</span><span class="visually-hidden">{t.newTab}</span>
    </a>
  </div>

  <div class="stream__stage" data-stream-stage>
    <img src={asset(first.src!)} width={first.w} height={first.h} alt="" loading="lazy" decoding="async" />
  </div>

  <p class="stream__text" data-stream-text>{first.text}</p>
  <p class="stream__date" data-stream-date>{first.date}</p>

  <div class="stream__controls only-js">
    <button class="stream__button" type="button" data-stream-toggle aria-pressed="false">{t.streamPause}</button>
    <button class="stream__button" type="button" data-stream-sound aria-pressed="false" hidden>{t.streamSoundOn}</button>
    <button class="stream__button stream__button--next" type="button" data-stream-next>{t.streamNext}<span aria-hidden="true">→</span></button>
  </div>
</section>

<style>
  .stream {
    margin-block: var(--space-2);
  }

  .stream__head,
  .stream__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap);
  }

  .stream__label {
    margin: 0;
    font: inherit;
  }

  .stream__count {
    margin-left: 0.25em;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .stream__source {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: var(--tap);
    color: var(--color-muted);
    font-size: var(--text-meta);
    text-decoration: none;
  }

  .stream__source:hover {
    color: var(--color-text);
  }

  /* Постоянная сцена: вертикальные и горизонтальные посты не двигают страницу. */
  .stream__stage {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    margin-inline: calc(var(--gutter) * -1);
    overflow: hidden;
    background: var(--color-press);
  }

  .stream__stage :global(img),
  .stream__stage :global(video) {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: stream-in var(--duration-reveal, 300ms) ease both;
  }

  .stream__stage :global(audio) {
    width: calc(100% - var(--gutter) * 2);
  }

  .stream__stage :global(.stream__quote) {
    margin: 0;
    padding: var(--gutter);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    text-wrap: balance;
  }

  @keyframes stream-in {
    from {
      opacity: 0;
    }
  }

  .stream__text {
    display: -webkit-box;
    margin: var(--space-2) 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    min-height: 1.35em;
    font-family: var(--font-display);
    line-height: 1.35;
    white-space: pre-line;
  }

  .stream__date {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .stream__controls {
    margin-top: var(--space-1);
    justify-content: flex-start;
  }

  .stream__button {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-meta);
    cursor: pointer;
    transition: color var(--duration) ease;
  }

  .stream__button[hidden] {
    display: none;
  }

  .stream__button:hover {
    color: var(--color-text);
  }

  .stream__button--next {
    margin-left: auto;
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .stream__stage :global(img),
    .stream__stage :global(video) {
      animation: none;
    }
  }

  @media (min-width: 48rem) {
    .stream__stage {
      max-width: 30rem;
      margin-inline: 0;
    }
  }
</style>
