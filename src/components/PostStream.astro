---
// Случайные посты канала: сменяют друг друга в случайном порядке, всё играет здесь.
// Без JS остаётся один пост со ссылкой на Telegram.
import { toLocale, ui } from '../lib/i18n';
import { asset } from '../data/asset';
import posts from '../content/stream/bessmislennost.json';

type Props = { source: string; channel: string };
const { source, channel } = Astro.props;
const t = ui[toLocale(Astro.currentLocale)];
const first = posts.find((p) => p.kind === 'image')!;
---
<section
  class="stream"
  aria-label={t.streamLabel}
  data-stream={asset(source)}
  data-base={asset('/')}
  data-channel={channel}
  data-pause={t.streamPause}
  data-play={t.streamPlay}
  data-sound-on={t.streamSoundOn}
  data-sound-off={t.streamSoundOff}
>
  <div class="stream__head">
    <h3 class="stream__label">{t.streamLabel} <span class="stream__count" data-stream-count>{posts.length}</span></h3>
    <a class="stream__source" data-stream-link href={`${channel}/${first.post}`} target="_blank" rel="noopener">
      Telegram<span aria-hidden="true">↗</span><span class="visually-hidden">{t.newTab}</span>
    </a>
  </div>

  <div class="stream__screen">
    <div class="stream__stage" data-stream-stage>
      <img src={asset(first.src!)} width={first.w} height={first.h} alt="" loading="lazy" decoding="async" />
    </div>
    <button class="stream__sound" type="button" data-stream-sound hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path class="stream__speaker" d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z" />
        <path class="stream__waves" d="M15 9a4 4 0 0 1 0 6M17.5 6.5a7.5 7.5 0 0 1 0 11" />
        <path class="stream__cross" d="M15.5 9.5l5 5M20.5 9.5l-5 5" />
      </svg>
      <span data-stream-sound-label>{t.streamSoundOn}</span>
    </button>
    <p class="stream__hint" data-stream-hint hidden><span aria-hidden="true">←</span> {t.streamHint} <span aria-hidden="true">→</span></p>
  </div>

  <p class="stream__text" data-stream-text>{first.text}</p>
  <p class="stream__date" data-stream-date>{first.date}</p>

  <div class="stream__controls only-js">
    <button class="stream__button" type="button" data-stream-toggle aria-pressed="false">{t.streamPause}</button>
    <span class="stream__arrows">
      <button class="stream__button stream__arrow" type="button" data-stream-prev aria-label={t.streamPrev} disabled>←</button>
      <button class="stream__button stream__arrow" type="button" data-stream-next aria-label={t.streamNext}>→</button>
    </span>
  </div>
</section>

<style>
  .stream {
    margin-block: var(--space-2);
  }

  .stream__head,
  .stream__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap);
  }

  .stream__label {
    margin: 0;
    font: inherit;
  }

  .stream__count {
    margin-left: 0.25em;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .stream__source {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: var(--tap);
    color: var(--color-muted);
    font-size: var(--text-meta);
    text-decoration: none;
  }

  .stream__source:hover {
    color: var(--color-text);
  }

  .stream__screen {
    position: relative;
    margin-inline: calc(var(--gutter) * -1);
  }

  /* Постоянная сцена: вертикальные и горизонтальные посты не двигают страницу. */
  .stream__stage {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-press);
  }

  .stream__stage {
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: grab;
  }

  .stream__stage:active {
    cursor: grabbing;
  }

  /* Соседний пост во время свайпа. */
  .stream__stage :global(.stream__ghost) {
    position: absolute;
    inset: 0;
    background: var(--color-press) center / contain no-repeat;
  }

  /* Подсказка видна, пока человек ни разу не пролистал. */
  .stream__hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-1);
    display: flex;
    gap: 0.5em;
    margin: 0;
    padding: 0.35rem 0.85rem;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    border-radius: 999px;
    color: var(--color-text);
    font-size: var(--text-meta);
    white-space: nowrap;
    pointer-events: none;
  }

  .stream__hint[hidden] {
    display: none;
  }

  /* Кнопка звука на самом кадре, там же, где её ищут в сторис и Reels.
     Пока звук выключен, рядом со значком написано, что делать. Верхний угол не спорит с панелью видео. */
  .stream__sound {
    position: absolute;
    top: var(--space-1);
    right: var(--space-1);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0 0.85rem 0 0.7rem;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
    border-radius: 999px;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-meta);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background var(--duration) ease;
  }

  .stream__sound:hover {
    background: var(--color-bg);
  }

  .stream__sound[hidden] {
    display: none;
  }

  .stream__sound svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stream__speaker {
    fill: currentColor;
  }

  .stream__waves {
    display: none;
  }

  /* Звук включён: остаётся только значок, красный как акцент сайта. */
  .stream__sound[data-on] {
    justify-content: center;
    padding: 0;
    color: var(--color-accent);
  }

  .stream__sound[data-on] .stream__waves {
    display: block;
  }

  .stream__sound[data-on] .stream__cross {
    display: none;
  }

  .stream__sound[data-on] span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Абсолютная привязка к сцене: в Safari height: 100% внутри aspect-ratio не работает,
     и вертикальный кадр вырастал за сцену, а низ обрезался. */
  .stream__stage :global(img),
  .stream__stage :global(video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: stream-in var(--duration-reveal, 300ms) ease both;
  }

  .stream__stage :global(audio) {
    width: calc(100% - var(--gutter) * 2);
  }

  .stream__stage :global(.stream__quote) {
    margin: 0;
    padding: var(--gutter);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    text-wrap: balance;
  }

  @keyframes stream-in {
    from {
      opacity: 0;
    }
  }

  .stream__text {
    display: -webkit-box;
    margin: var(--space-2) 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    min-height: 1.35em;
    font-family: var(--font-display);
    line-height: 1.35;
    white-space: pre-line;
  }

  .stream__date {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .stream__controls {
    margin-top: var(--space-1);
    justify-content: flex-start;
  }

  .stream__button {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-meta);
    cursor: pointer;
    transition: color var(--duration) ease;
  }

  .stream__button[hidden] {
    display: none;
  }

  .stream__button:hover {
    color: var(--color-text);
  }

  .stream__arrows {
    display: flex;
    margin-left: auto;
  }

  .stream__arrow {
    justify-content: center;
    color: var(--color-text);
    font-size: var(--text-body);
  }

  .stream__arrow:disabled {
    color: var(--color-line-strong);
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .stream__stage :global(img),
    .stream__stage :global(video) {
      animation: none;
    }
  }

  @media (min-width: 48rem) {
    .stream__screen {
      max-width: 28rem;
      margin-inline: 0;
    }
  }
</style>
