---
// Случайные посты канала: сменяют друг друга в случайном порядке, всё играет здесь.
// Без JS остаётся один пост со ссылкой на Telegram.
import { toLocale, ui } from '../lib/i18n';
import { asset } from '../data/asset';
import { streamPosts } from '../lib/stream';
import { englishDate } from '../lib/stream-date';

type Props = { source: string; channel: string; label?: string; film?: boolean };
const { source, channel, label, film = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui[locale];
const posts = streamPosts(source);
const first = posts.find((p) => p.lead) ?? posts.find((p) => p.kind === 'image') ?? posts[0];
const still = first.poster ?? first.src!;
---
<section
  class:list={['stream', { 'stream--film': film }]}
  aria-label={label ?? t.streamLabel}
  data-order={film ? 'sequence' : undefined}
  data-stream={asset(source)}
  data-base={asset('/')}
  data-channel={channel}
  data-pause={t.streamPause}
  data-play={t.streamPlay}
  data-sound-on={t.streamSoundOn}
  data-sound-off={t.streamSoundOff}
  data-full-on={t.streamFullOn}
  data-full-off={t.streamFullOff}
  data-en={locale === 'en' ? '' : undefined}
>
  <div class="stream__head">
    <h3 class="stream__label"><span class="visually-hidden">{label ?? t.streamLabel}</span><span class="stream__count" data-stream-count>{posts.length}</span></h3>
    <a class="stream__source" data-stream-link href={first.url ?? `${channel}/${first.post}`} target="_blank" rel="noopener">
      Telegram<span aria-hidden="true">↗</span><span class="visually-hidden">{t.newTab}</span>
    </a>
  </div>

  <div class="stream__screen">
    <div class="stream__stage" data-stream-stage>
      <img src={asset(still)} width={first.w} height={first.h} alt="" loading="lazy" decoding="async" />
    </div>
    <button class="stream__side stream__side--prev" type="button" data-stream-prev aria-label={t.streamPrev} disabled>←</button>
    <button class="stream__side stream__side--next" type="button" data-stream-next aria-label={t.streamNext}>→</button>
    <p class="stream__hint" data-stream-hint hidden><span aria-hidden="true">←</span> <span aria-hidden="true">→</span></p>
  </div>

  <p class="stream__text" data-stream-text>{(locale === 'en' && first.textEn) || first.text}</p>
  <p class="stream__date" data-stream-date>{locale === 'en' ? englishDate(first.date) : first.date}</p>

  <div class="stream__controls only-js">
    <button class="stream__button stream__icon" type="button" data-stream-toggle aria-pressed="false" aria-label={t.streamPause}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path class="stream__pause" d="M8 5v14M16 5v14" />
        <path class="stream__play" d="M7 4.5v15L19.5 12z" />
      </svg>
    </button>
    <button class="stream__button stream__sound" type="button" data-stream-sound hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path class="stream__speaker" d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z" />
        <path class="stream__waves" d="M15 9a4 4 0 0 1 0 6M17.5 6.5a7.5 7.5 0 0 1 0 11" />
        <path class="stream__cross" d="M15.5 9.5l5 5M20.5 9.5l-5 5" />
      </svg>
      <span data-stream-sound-label>{t.streamSoundOn}</span>
    </button>
    <span class="stream__tools">
      <button class="stream__button stream__icon" type="button" data-stream-full aria-label={t.streamFullOn} hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path class="stream__expand" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
          <path class="stream__shrink" d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
        </svg>
      </button>
      <span class="stream__arrows">
        <button class="stream__button stream__arrow" type="button" data-stream-prev aria-label={t.streamPrev} disabled>←</button>
        <button class="stream__button stream__arrow" type="button" data-stream-next aria-label={t.streamNext}>→</button>
      </span>
    </span>
  </div>
</section>

<style>
  .stream {
    margin-block: var(--space-2);
  }

  .stream__head,
  .stream__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap);
  }

  .stream__label {
    margin: 0;
    font: inherit;
  }

  .stream__count {
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .stream__source {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: var(--tap);
    color: var(--color-muted);
    font-size: var(--text-meta);
    text-decoration: none;
  }

  .stream__source:hover {
    color: var(--color-text);
  }

  .stream__screen {
    position: relative;
    margin-inline: calc(var(--gutter) * -1);
  }

  /* Постоянная сцена: вертикальные и горизонтальные посты не двигают страницу. */
  .stream__stage {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-press);
  }

  .stream__stage {
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: grab;
  }

  .stream__stage:active {
    cursor: grabbing;
  }

  /* Главы сняты в 16:9: сцена по кадру, без пустых полос. */
  .stream--film .stream__stage {
    aspect-ratio: 16 / 9;
  }

  /* Соседний пост во время свайпа. */
  .stream__stage :global(.stream__ghost) {
    position: absolute;
    inset: 0;
    background: var(--color-press) center / contain no-repeat;
  }

  /* Короткое движение стрелок показывает направление свайпа. */
  .stream__hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-1);
    display: flex;
    gap: 0.5em;
    margin: 0;
    padding: 0.35rem 0.85rem;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    border-radius: 999px;
    color: var(--color-text);
    font-size: var(--text-meta);
    white-space: nowrap;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stream__hint:not([hidden]) {
      animation: swipe-hint 1.4s ease both;
    }

    @keyframes swipe-hint {
      0% { opacity: 0; transform: translateX(-50%); }
      18% { opacity: 1; transform: translateX(-50%); }
      52%, 70% { opacity: 1; transform: translateX(calc(-50% - 0.65rem)); }
      100% { opacity: 0; transform: translateX(calc(-50% - 0.65rem)); }
    }
  }

  .stream__hint[hidden] {
    display: none;
  }

  /* Стрелки на кадре только для мыши. На телефоне вместо них свайп. */
  .stream__side {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .stream__hint {
      display: none;
    }

    .stream__controls .stream__arrows {
      display: none;
    }

    .stream__side {
      position: absolute;
      top: 50%;
      display: grid;
      place-items: center;
      width: var(--tap);
      height: var(--tap);
      padding: 0;
      transform: translateY(-50%);
      background: color-mix(in srgb, var(--color-bg) 72%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
      border-radius: 50%;
      color: var(--color-text);
      font: inherit;
      cursor: pointer;
      transition: background var(--duration) ease;
    }

    .stream__side:hover {
      background: var(--color-bg);
    }

    .stream__side:disabled {
      display: none;
    }

    .stream__side--prev {
      left: var(--space-1);
    }

    .stream__side--next {
      right: var(--space-1);
    }
  }

  /* Абсолютная привязка к сцене: в Safari height: 100% внутри aspect-ratio не работает,
     и вертикальный кадр вырастал за сцену, а низ обрезался. */
  .stream__stage :global(img),
  .stream__stage :global(video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: stream-in var(--duration-reveal, 300ms) ease both;
  }

  /* Плеер сверху, а не по центру: он забирает касания себе, и свайп по середине кадра не работал бы. */
  .stream__stage :global(audio) {
    position: absolute;
    top: var(--space-2);
    width: calc(100% - var(--gutter) * 2);
  }

  .stream__stage :global(.stream__quote) {
    margin: 0;
    padding: var(--gutter);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    text-wrap: balance;
  }

  @keyframes stream-in {
    from {
      opacity: 0;
    }
  }

  .stream__text {
    display: -webkit-box;
    margin: var(--space-2) 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    min-height: 1.35em;
    font-family: var(--font-display);
    line-height: 1.35;
    white-space: pre-line;
  }

  .stream__date {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .stream__controls {
    gap: 0;
    margin-top: var(--space-1);
    justify-content: flex-start;
  }

  .stream__button {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-meta);
    cursor: pointer;
    transition: color var(--duration) ease;
  }

  .stream__button[hidden] {
    display: none;
  }

  .stream__button:hover {
    color: var(--color-text);
  }

  /* Кадр остаётся чистым: всё управление в одном ряду под ним. */
  .stream__tools,
  .stream__arrows {
    display: flex;
  }

  .stream__tools {
    margin-left: auto;
  }

  .stream__icon {
    justify-content: center;
    color: var(--color-text);
  }

  .stream__button svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stream__play,
  .stream__shrink,
  [aria-pressed='true'] .stream__pause,
  [data-on] .stream__expand {
    display: none;
  }

  [aria-pressed='true'] .stream__play,
  [data-on] .stream__shrink {
    display: inline;
  }

  .stream__play {
    fill: currentColor;
  }

  /* Пока звук выключен, рядом со значком написано, что делать. На самых узких экранах только значок. */
  .stream__sound {
    justify-content: center;
    color: var(--color-text);
  }

  .stream__sound span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 22.5rem) {
    .stream__sound {
      flex: none;
    }

    .stream__sound:not([data-on]) span {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
  }

  .stream__speaker {
    fill: currentColor;
  }

  .stream__waves {
    display: none;
  }

  /* Звук включён: красный значок, как акцент сайта. */
  .stream__sound[data-on] {
    color: var(--color-accent);
  }

  .stream__sound[data-on] .stream__waves {
    display: block;
  }

  .stream__sound[data-on] .stream__cross {
    display: none;
  }

  /* На весь экран: только кадр, ряд кнопок сверху и исчезает, пока его не трогают.
     Сверху, потому что низ на паузе занят панелью видео. */
  .stream:fullscreen {
    position: relative;
    margin: 0;
    background: var(--color-press);
  }

  .stream:fullscreen .stream__head,
  .stream:fullscreen .stream__text,
  .stream:fullscreen .stream__date {
    display: none;
  }

  .stream:fullscreen .stream__screen {
    position: absolute;
    inset: 0;
    max-width: none;
    margin: 0;
  }

  .stream:fullscreen .stream__stage {
    height: 100%;
    aspect-ratio: auto;
  }

  .stream:fullscreen .stream__controls {
    position: absolute;
    inset: 0 0 auto;
    margin: 0;
    padding: var(--space-1) var(--gutter);
    background: linear-gradient(color-mix(in srgb, var(--color-bg) 80%, transparent), transparent);
    transition: opacity var(--duration) ease;
  }

  .stream[data-idle]:fullscreen {
    cursor: none;
  }

  .stream[data-idle]:fullscreen .stream__controls {
    opacity: 0;
    pointer-events: none;
  }

  .stream__arrow {
    justify-content: center;
    color: var(--color-text);
    font-size: var(--text-body);
  }

  .stream__arrow:disabled {
    color: var(--color-line-strong);
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .stream__stage :global(img),
    .stream__stage :global(video) {
      animation: none;
    }
  }

  @media (min-width: 48rem) {
    .stream__screen {
      max-width: 28rem;
      margin-inline: 0;
    }

    .stream--film .stream__screen {
      max-width: none;
    }
  }
</style>
