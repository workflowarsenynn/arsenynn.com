---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import WorldBar from '../WorldBar.astro';
import SiteFooter from '../SiteFooter.astro';
import { asset } from '../../data/asset';
import { channelUrl, getSeries, plural, seriesPath } from '../../lib/annflow';
import { getProjects } from '../../data/projects';
import { toLocale, ui } from '../../lib/i18n';

const locale = toLocale(Astro.currentLocale);
const t = ui[locale];
const a = t.annflow;
const series = await getSeries(locale);
const annflow = (await getProjects(locale)).find((p) => p.id === 'annflow')!;
const notes = series.reduce((sum, s) => sum + s.notes.length, 0);
const hours = Math.round(series.reduce((sum, s) => sum + s.minutes, 0) / 60);
---
<Base title="annFlow — @arsenynn" description={annflow.shortDescription} alternate="/annflow/">
  <WorldBar crumbs={[]} alternate="/annflow/" />
  <main class="container world">
    <header class="world__head">
      <h1 class="world__mark">
        <img src={asset('/logos/annflow.webp')} width="290" height="110" alt="annFlow" />
      </h1>
      <p class="world__lead">{annflow.shortDescription}</p>
      <p class="world__count">{series.length} {a.series} · {notes} {plural(notes, a.noteOne, a.noteFew, a.noteMany)} · {a.about} {hours} {plural(hours, a.hourOne, a.hourFew, a.hourMany)} {a.reading}</p>
    </header>

    <ol class="series-list">
      {series.map((s) => (
        <li>
          <a class="series-row" href={asset(seriesPath(locale, s.slug))}>
            <span class="series-row__frame" aria-hidden="true">
              {s.cover && <Image src={s.cover} alt="" width={288} loading="lazy" decoding="async" />}
            </span>
            <span class="series-row__text">
              <span class="series-row__title">{s.title}</span>
              <span class="series-row__note">{s.note}</span>
              <span class="series-row__meta">{s.notes.length} {plural(s.notes.length, a.noteOne, a.noteFew, a.noteMany)} · {s.minutes} {a.min}</span>
            </span>
            <span class="series-row__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="world__source">
      <a class="action action--text" href={channelUrl} target="_blank" rel="noopener">
        {a.channel}<span class="action__arrow" aria-hidden="true">↗</span><span class="visually-hidden">{t.newTab}</span>
      </a>
    </p>
  </main>
  <SiteFooter />
</Base>

<style>
  .world {
    max-width: var(--index-width);
    padding-bottom: var(--space-5);
  }

  .world__head {
    padding-block: var(--space-4);
  }

  .world__mark {
    margin: 0 0 var(--space-3);
    line-height: 0;
  }

  .world__mark img {
    width: 11rem;
    height: auto;
  }

  .world__lead {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    text-wrap: balance;
  }

  .world__count {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .series-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .series-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background var(--duration) ease;
  }

  .series-row:hover,
  .series-row:active {
    background: var(--color-press);
  }

  .series-row__frame {
    flex: none;
    width: 5.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-press);
  }

  .series-row__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-row__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .series-row__title {
    font-family: var(--font-display);
    font-size: var(--text-body);
    line-height: 1.25;
  }

  .series-row__note,
  .series-row__meta {
    color: var(--color-muted);
    font-size: var(--text-meta);
    line-height: 1.4;
  }

  .series-row__meta {
    font-variant-numeric: tabular-nums;
  }

  .series-row__arrow {
    flex: none;
    color: var(--color-muted);
  }

  .world__source {
    margin: var(--space-3) 0 0;
    font-size: var(--text-meta);
  }

  @media (min-width: 48rem) {
    .series-row__frame {
      width: 9rem;
    }
  }
</style>
