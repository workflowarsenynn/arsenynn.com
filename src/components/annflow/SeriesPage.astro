---
import Base from '../../layouts/Base.astro';
import WorldBar from '../WorldBar.astro';
import NoteBody from '../NoteBody.astro';
import SiteFooter from '../SiteFooter.astro';
import { asset } from '../../data/asset';
import { formatDate, minutesOf, plural, seriesPath, type Note, type Series } from '../../lib/annflow';
import { localePath, toLocale, ui } from '../../lib/i18n';

type Props = { series: Series; next?: Series };
const { series, next } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const a = ui[locale].annflow;
// Значки в оглавлении: что есть в посте, кроме текста.
const labels = { video: a.video, image: a.image } as const;
const glyphs = { video: 'M5 3.5v9l7.5-4.5z', image: 'M2.5 3.5h11v9h-11zM2.5 10.5l3-3 2.5 2.5 2-2 3.5 3.5' };
const kinds = (n: Note) => (['video', 'image'] as const).filter((kind) => n.data.media?.some((m) => m.type === kind));
---
<Base title={`${series.title} — annFlow`} description={series.note} alternate={`/annflow/projects/${series.slug}/`}>
  <WorldBar crumbs={[{ label: 'annFlow', href: '/annflow/' }]} alternate={`/annflow/projects/${series.slug}/`} />
  <main class="container series">
    <header class="series__head">
      <h1>{series.title}</h1>
      <p class="series__note">{series.note}</p>
      <p class="series__meta">{series.notes.length} {plural(series.notes.length, a.noteOne, a.noteFew, a.noteMany)} · {series.minutes} {a.min}</p>
    </header>

    {series.intro.data.media?.length && <div class="series__intro"><NoteBody note={series.intro} /></div>}

    <h2 class="visually-hidden" id="toc">{a.contents}</h2>
    <ol class="toc">
      {series.notes.map((n, i) => (
        <li>
          <a href={`#note-${n.id}`}>
            <span class="toc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="toc__title">{n.data.title}</span>
            {kinds(n).map((kind) => (
              <span class="toc__media" title={labels[kind]}>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d={glyphs[kind]} /></svg>
                <span class="visually-hidden">{labels[kind]}</span>
              </span>
            ))}
            <span class="toc__time">{minutesOf(n)} {a.min}</span>
          </a>
        </li>
      ))}
      {series.planned.map((title, i) => (
        <li class="toc__planned">
          <span class="toc__num" aria-hidden="true">{String(series.notes.length + i + 1).padStart(2, '0')}</span>
          <span class="toc__title">{title}</span>
          <span class="toc__time">{a.soon}</span>
        </li>
      ))}
    </ol>

    <div class="posts">
      {series.notes.map((n, i) => (
        <article class="post" id={`note-${n.id}`}>
          <header class="post__head">
            <p class="post__meta">
              <span>{i + 1} {a.of} {series.notes.length + series.planned.length}</span>
              <span>{minutesOf(n)} {a.min}</span>
              <time datetime={n.data.publishedAt.toISOString()}>{formatDate(n.data.publishedAt, locale)}</time>
            </p>
            <h2><a href={asset(localePath(locale, `/annflow/notes/${n.id}/`))}>{n.data.title}</a></h2>
          </header>
          <NoteBody note={n} />
          <p class="post__up"><a href="#toc">{a.toContents} <span aria-hidden="true">↑</span></a></p>
        </article>
      ))}
    </div>

    {next && (
      <p class="series__next">
        <span>{a.nextSeries}</span>
        <a href={asset(seriesPath(locale, next.slug))}>{next.title} <span aria-hidden="true">→</span></a>
      </p>
    )}
  </main>
  <SiteFooter />
</Base>

<style>
  .series {
    max-width: var(--index-width);
    padding-bottom: var(--space-5);
  }

  .series__head {
    padding-block: var(--space-4);
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 400;
    line-height: 1.1;
    text-wrap: balance;
  }

  .series__note {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    text-wrap: balance;
  }

  .series__meta {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .toc {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .series__intro {
    margin-bottom: var(--space-3);
  }

  .toc a,
  .toc__planned {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: var(--tap-row);
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-line);
  }

  .toc__planned {
    color: var(--color-muted);
  }

  .toc__media {
    flex: none;
    align-self: center;
    display: inline-flex;
    margin-right: calc(var(--space-1) * -1);
  }

  .toc__media svg {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .toc a {
    color: var(--color-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background var(--duration) ease;
  }

  .toc a:hover,
  .toc a:active {
    background: var(--color-press);
  }

  .toc__num,
  .toc__time {
    flex: none;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .toc__title {
    flex: 1;
    min-width: 0;
    line-height: 1.35;
  }

  #toc,
  .post {
    scroll-margin-top: var(--space-3);
  }

  .post {
    max-width: 44rem;
    margin-inline: auto;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }

  .post__head {
    margin-bottom: var(--space-2);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .post h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1.2vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    text-wrap: balance;
  }

  .post h2 a {
    color: inherit;
    text-decoration: none;
  }

  .post h2 a:hover {
    color: var(--color-accent);
  }

  .post__up {
    margin: var(--space-1) 0 0;
    font-size: var(--text-meta);
  }

  .post__up a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-muted);
    text-decoration: none;
  }

  .post__up a:hover {
    color: var(--color-text);
  }

  .series__next {
    display: flex;
    flex-direction: column;
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
  }

  .series__next a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    text-decoration: none;
  }
</style>
