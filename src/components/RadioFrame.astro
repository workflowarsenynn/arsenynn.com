---
// Радио в маленьком окне: настоящий сайт эфира, уменьшенный целиком, поэтому кнопки в нём
// остаются пропорциональными кадру. Запуск кнопкой внутри окна: так звук разрешён и на iPhone.
// allow="autoplay" не ставим, иначе эфир сам заиграет при прокрутке страницы.
import { toLocale, ui } from '../lib/i18n';

type Props = { url: string; title: string };
const { url, title } = Astro.props;
const t = ui[toLocale(Astro.currentLocale)];
---
<section class="radio" aria-label={t.radioLabel}>
  <div class="radio__head">
    <h3 class="radio__label">{t.radioLabel}<span class="action__live" aria-hidden="true"></span></h3>
  </div>
  <div class="radio__screen">
    <iframe data-radio={url} title={title}></iframe>
    <!-- Волна вокруг кнопки запуска внутри окна: без слов показывает, куда нажать. Клики проходят насквозь. -->
    <span class="radio__nudge" aria-hidden="true"></span>
  </div>
</section>

<script>
  // Эфир грузится, только когда окно на экране: сразу тянет около 7 MB и считает слушателя.
  document.querySelectorAll<HTMLIFrameElement>('[data-radio]').forEach((frame) => {
    const radio = frame.closest('.radio')!;
    const seen = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      frame.src = frame.dataset.radio!;
      radio.classList.add('is-live');
      seen.disconnect();
    }, { rootMargin: '200px' });
    seen.observe(frame);

    // Звук на сайте один. Окно чужое, поставить его на паузу нельзя, поэтому выгружаем:
    // эфир замолкает, а когда окно снова на экране, загружается с кнопкой запуска.
    document.addEventListener('site-sound', (event) => {
      if ((event as CustomEvent).detail === frame || !frame.src.startsWith('http')) return;
      frame.src = 'about:blank';
      radio.classList.remove('is-live', 'is-playing');
      seen.observe(frame);
    });

    // Нажатие внутри окна видно только по уходу фокуса со страницы. На iPhone такого сигнала может не быть.
    window.addEventListener('blur', () => {
      if (document.activeElement !== frame) return;
      radio.classList.add('is-playing');
      document.dispatchEvent(new CustomEvent('site-sound', { detail: frame }));
      document.dispatchEvent(new CustomEvent('site-metric', { detail: { name: 'radio_start' } }));
    });
  });
</script>

<style>
  .radio {
    --radio-scale: 0.6;
    margin-block: var(--space-2);
  }

  .radio__head {
    display: flex;
    align-items: center;
    min-height: var(--tap);
  }

  .radio__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin: 0;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-meta);
    white-space: nowrap;
  }

  .radio__screen {
    container: radio-screen / inline-size;
    position: relative;
    margin-inline: calc(var(--gutter) * -1);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-press);
  }

  .radio__screen iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% / var(--radio-scale));
    height: calc(100% / var(--radio-scale));
    border: 0;
    transform: scale(var(--radio-scale));
    transform-origin: 0 0;
  }

  /* Кнопка запуска на сайте радио: окно уже 800 px сайта — 78 px в 20 px от угла, шире — 84 px в 30 и 26 px.
     Кнопка также учитывает safe area iPhone, в том числе во встроенных браузерах.
     Пиксели сайта радио вместе с safe area переводим в наши через масштаб окна. */
  .radio__nudge {
    --size: 78px;
    --right: 20px;
    --bottom: 20px;
    position: absolute;
    right: calc((var(--right) + env(safe-area-inset-right, 0px)) * var(--radio-scale));
    bottom: calc((var(--bottom) + env(safe-area-inset-bottom, 0px)) * var(--radio-scale));
    width: calc(var(--size) * var(--radio-scale));
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .radio__nudge::before,
  .radio__nudge::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    opacity: 0;
    animation: radio-nudge 2.8s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }

  .radio__nudge::after {
    animation-delay: 1.4s;
  }

  .is-live:not(.is-playing) .radio__nudge {
    opacity: 1;
    transition-delay: 1.2s;
  }

  @keyframes radio-nudge {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }

    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radio__nudge::before {
      animation: none;
      transform: scale(1.12);
      opacity: 0.7;
    }

    .radio__nudge::after {
      display: none;
    }
  }

  @container radio-screen (min-width: 480px) {
    .radio__nudge {
      --size: 84px;
      --right: 30px;
      --bottom: 26px;
    }
  }

  @media (min-width: 48rem) {
    .radio {
      --radio-scale: 0.8;
    }

    .radio__screen {
      margin-inline: 0;
    }
  }

  /* На широком экране масштаб 0.8: 800 px сайта радио — это 640 px окна. */
  @media (min-width: 48rem) {
    @container radio-screen (max-width: 639.98px) {
      .radio__nudge {
        --size: 78px;
        --right: 20px;
        --bottom: 20px;
      }
    }
  }
</style>
