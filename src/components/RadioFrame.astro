---
// Радио в маленьком окне: настоящий сайт эфира, уменьшенный целиком, поэтому кнопки в нём
// остаются пропорциональными кадру. Запуск кнопкой внутри окна: так звук разрешён и на iPhone.
// allow="autoplay" не ставим, иначе эфир сам заиграет при прокрутке страницы.
import { toLocale, ui } from '../lib/i18n';

type Props = { url: string; title: string };
const { url, title } = Astro.props;
const t = ui[toLocale(Astro.currentLocale)];
---
<section class="radio" aria-label={t.radioLabel}>
  <div class="radio__head">
    <h3 class="radio__label">{t.radioLabel}<span class="action__live" aria-hidden="true"></span></h3>
    <!-- Кнопка запуска внутри чужого окна внизу справа: подсказка над ней показывает, куда нажать. -->
    <p class="radio__hint">{t.radioHint}<span aria-hidden="true">↘</span></p>
  </div>
  <div class="radio__screen">
    <iframe data-radio={url} title={title}></iframe>
  </div>
</section>

<script>
  // Эфир грузится, только когда окно на экране: сразу тянет около 7 MB и считает слушателя.
  document.querySelectorAll<HTMLIFrameElement>('[data-radio]').forEach((frame) => {
    const seen = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      frame.src = frame.dataset.radio!;
      seen.disconnect();
    }, { rootMargin: '200px' });
    seen.observe(frame);

    const radio = frame.closest('.radio')!;

    // Звук на сайте один. Окно чужое, поставить его на паузу нельзя, поэтому выгружаем:
    // эфир замолкает, а когда окно снова на экране, загружается с кнопкой запуска.
    document.addEventListener('site-sound', (event) => {
      if ((event as CustomEvent).detail === frame || !frame.src.startsWith('http')) return;
      frame.src = 'about:blank';
      radio.classList.remove('is-playing');
      seen.observe(frame);
    });

    // Нажатие внутри окна видно только по уходу фокуса со страницы. На iPhone такого сигнала может не быть.
    window.addEventListener('blur', () => {
      if (document.activeElement !== frame) return;
      radio.classList.add('is-playing');
      document.dispatchEvent(new CustomEvent('site-sound', { detail: frame }));
      document.dispatchEvent(new CustomEvent('site-metric', { detail: { name: 'radio_start' } }));
    });
  });
</script>

<style>
  .radio {
    --radio-scale: 0.6;
    margin-block: var(--space-2);
  }

  .radio__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-2);
    min-height: var(--tap);
    padding-block: 0.4em;
  }

  .radio__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin: 0;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-meta);
    white-space: nowrap;
  }

  .radio__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    margin: 0 0 0 auto;
    color: var(--color-text);
    white-space: nowrap;
    font-size: var(--text-meta);
    transition: opacity 0.4s ease;
  }

  .is-playing .radio__hint {
    opacity: 0;
  }

  .radio__screen {
    position: relative;
    margin-inline: calc(var(--gutter) * -1);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-press);
  }

  .radio__screen iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% / var(--radio-scale));
    height: calc(100% / var(--radio-scale));
    border: 0;
    transform: scale(var(--radio-scale));
    transform-origin: 0 0;
  }

  @media (min-width: 48rem) {
    .radio {
      --radio-scale: 0.8;
    }

    .radio__screen {
      margin-inline: 0;
    }
  }
</style>
